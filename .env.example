# Arabic Research Intelligence - Environment Configuration

# Server Base URL (used for CORS / CSRF origin validation)
APP_BASE_URL=http://localhost:3000

# Google Gemini API Key (Free tier from Google AI Studio)
# Required for real AI copilot features (Phase 0+)
GEMINI_API_KEY=

# Commit SHA (Injected automatically by Render at runtime or CI build)
NEXT_PUBLIC_GIT_COMMIT_SHA=dev-local

# Authentication Demo Account Salts and Hashes (scrypt: N=16384, r=8, p=1, keylen=64)
# Salts are 16 bytes hex (32 hex characters), Hashes are 64 bytes hex (128 hex characters)
DEMO_SALT_ADMIN=
DEMO_HASH_ADMIN=
DEMO_SALT_SUPERVISOR=
DEMO_HASH_SUPERVISOR=
DEMO_SALT_SCHOLAR=
DEMO_HASH_SCHOLAR=
DEMO_SALT_STUDENT=
DEMO_HASH_STUDENT=
